# Headless: the CMake lift resolution on a tree that holds only lifts/ and cmake/ (no game files, no analysis, no
# original executable, no unpacked sources):  cmake -DSOURCE=<tree> -P tests/lift_resolution_check.cmake
include("${SOURCE}/cmake/JptLifts.cmake")
foreach(forbidden game analysis external)
  if(EXISTS "${SOURCE}/${forbidden}")
    message(FATAL_ERROR "the clean tree must not have ${forbidden}")
  endif()
endforeach()
jpt_unpack_lifts("${SOURCE}")
foreach(lift IN LISTS JPT_LIFT_IDS)
  list(LENGTH ${lift}_SOURCES count)
  if(count LESS 70)
    message(FATAL_ERROR "${lift}: ${count} generated sources")
  endif()
  set(has_dispatch FALSE)
  foreach(file IN LISTS ${lift}_SOURCES)
    if(file MATCHES "recomp_dispatch.c$")
      set(has_dispatch TRUE)
    endif()
  endforeach()
  if(NOT has_dispatch)
    message(FATAL_ERROR "${lift}: no recomp_dispatch.c")
  endif()
  message(STATUS "RESOLVED ${lift} ${count}")
endforeach()
list(LENGTH GEN_SOURCES total)
message(STATUS "RESOLVED TOTAL ${total}")
