# cmake -DINPUT_LIST=<list.txt> -DOUTPUT=<file.c> -DSYMBOL=<name> -P embed_files_c.cmake : the files a list names as a table of
# { name, bytes, size } in the list's order, closed by a null entry (the C counterpart of launcher/embed_files.cmake).
file(READ "${INPUT_LIST}" inputs)
set(arrays "")
set(table "")
set(count 0)
foreach(input IN LISTS inputs)
    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    get_filename_component(name "${input}" NAME)
    string(APPEND arrays "static const unsigned char k${count}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${name}\", k${count}, ${size}},\n")
    math(EXPR count "${count} + 1")
endforeach()
file(WRITE "${OUTPUT}" "/* Generated by cmake/embed_files_c.cmake; do not edit. */
#include \"embedded_files.h\"

${arrays}
const jpt_embedded_file_t ${SYMBOL}[] = {
${table}    {0, 0, 0},
};
")
