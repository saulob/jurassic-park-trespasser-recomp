# The lifted builds are project artifacts: lifts/<lift>.tar.xz named by lifts/manifest.json (tools/lifts.py). Unpacking
# them into src/recomp/<gen dir> needs no game file and no original executable.
set(JPT_LIFT_IDS lift116 lift_es117 lift_ptbr117)

# Verifies each archive against the manifest and unpacks it when its folder is missing or made from another archive;
# GEN_SOURCES is every lift's generated C, <lift>_SOURCES the folder's own.
macro(jpt_unpack_lifts source_dir)
  set(_manifest "${source_dir}/lifts/manifest.json")
  if(NOT EXISTS "${_manifest}")
    message(FATAL_ERROR "${_manifest} is missing: the lifts are part of the source tree")
  endif()
  file(READ "${_manifest}" _manifest_text)
  if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}")
  endif()
  set(GEN_SOURCES)
  foreach(_lift IN LISTS JPT_LIFT_IDS)
    string(JSON _gen_dir ERROR_VARIABLE _error GET "${_manifest_text}" lifts ${_lift} gen_dir)
    if(_error)
      message(FATAL_ERROR "${_manifest} does not list ${_lift}")
    endif()
    string(JSON _archive_name GET "${_manifest_text}" lifts ${_lift} archive)
    string(JSON _expected GET "${_manifest_text}" lifts ${_lift} archive_sha256)
    set(_archive "${source_dir}/lifts/${_archive_name}")
    if(NOT EXISTS "${_archive}")
      message(FATAL_ERROR "${_archive} is missing: the lifts are part of the source tree (lifts/manifest.json)")
    endif()
    file(SHA256 "${_archive}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "${_archive} does not match lifts/manifest.json")
    endif()
    set(_dest "${source_dir}/src/recomp/${_gen_dir}")
    set(_current "")
    if(EXISTS "${_dest}/.archive_sha256")
      file(READ "${_dest}/.archive_sha256" _current)
    endif()
    if(NOT _current STREQUAL _expected)
      message(STATUS "unpacking ${_archive_name}")
      file(REMOVE_RECURSE "${_dest}")
      file(MAKE_DIRECTORY "${_dest}")
      file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${_dest}")
      file(WRITE "${_dest}/.archive_sha256" "${_expected}")
    endif()
    if(CMAKE_SCRIPT_MODE_FILE)
      file(GLOB _lift_sources "${_dest}/recomp_*.c")
    else()
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_archive}")
      file(GLOB _lift_sources CONFIGURE_DEPENDS "${_dest}/recomp_*.c")
    endif()
    if(NOT _lift_sources)
      message(FATAL_ERROR "${_archive_name} holds no generated sources")
    endif()
    set(${_lift}_SOURCES ${_lift_sources})
    list(APPEND GEN_SOURCES ${_lift_sources})
  endforeach()
endmacro()
