# Squirrel (config/launcher_deps.txt, patched by launcher/patches/squirrel) and the interpreter of Trespasser CE scripts
# over it (src/common/jpt_script_vm.cpp, docs/CE_SCRIPTS.md): the language and its math, string and blob libraries; no
# I/O, system or auxiliary library. Nothing of the game links them yet.
set(JPT_SQUIRREL_DIR "${CMAKE_SOURCE_DIR}/external/squirrel" CACHE PATH "patched Squirrel checkout (config/launcher_deps.txt)")
if(NOT EXISTS "${JPT_SQUIRREL_DIR}/include/squirrel.h")
  message(FATAL_ERROR "Squirrel sources missing: run tools/build.ps1 or tools/fetch_launcher_deps.py (config/launcher_deps.txt)")
endif()
set(JPT_SQUIRREL_SOURCES)
foreach(name sqapi sqbaselib sqclass sqcompiler sqdebug sqfuncstate sqlexer sqmem sqobject sqstate sqtable sqvm)
  list(APPEND JPT_SQUIRREL_SOURCES ${JPT_SQUIRREL_DIR}/squirrel/${name}.cpp)
endforeach()
foreach(name sqstdblob sqstdmath sqstdrex sqstdstream sqstdstring)
  list(APPEND JPT_SQUIRREL_SOURCES ${JPT_SQUIRREL_DIR}/sqstdlib/${name}.cpp)
endforeach()

add_library(jpt_squirrel STATIC EXCLUDE_FROM_ALL ${JPT_SQUIRREL_SOURCES})
target_include_directories(jpt_squirrel SYSTEM PUBLIC ${JPT_SQUIRREL_DIR}/include)
if(CMAKE_SIZEOF_VOID_P EQUAL 8)
  target_compile_definitions(jpt_squirrel PUBLIC _SQ64)
endif()
add_library(jpt_script STATIC EXCLUDE_FROM_ALL src/common/jpt_script_vm.cpp)
target_include_directories(jpt_script PUBLIC src/common)
target_link_libraries(jpt_script PUBLIC jpt_squirrel)
set_target_properties(jpt_squirrel jpt_script PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON)
if(MSVC)
  target_compile_options(jpt_squirrel PRIVATE /W0)
  target_compile_options(jpt_script PRIVATE /W4 /WX /utf-8)
  target_compile_definitions(jpt_script PRIVATE _CRT_SECURE_NO_WARNINGS)
else()
  target_compile_options(jpt_squirrel PRIVATE -w)
  target_compile_options(jpt_script PRIVATE ${JPT_LINUX_WARNINGS} ${JPT_LINUX_COMPAT})
endif()
