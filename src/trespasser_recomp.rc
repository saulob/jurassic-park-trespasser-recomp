#include <winuser.h>
#include <winver.h>
#include "jpt_version.h"

/* Resource 1 is the application icon: the Explorer icon, SDL's launcher window class and the game window (host/window_host.c). */
1 ICON "../packaging/icons/app-icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION JPT_VERSION_NUMBERS
PRODUCTVERSION JPT_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "saulob"
            VALUE "FileDescription", "Jurassic Park: Trespasser Recompiled"
            VALUE "FileVersion", JPT_FILE_VERSION_STRING
            VALUE "InternalName", "trespasser_recomp"
            VALUE "OriginalFilename", "trespasser_recomp.exe"
            VALUE "ProductName", "Jurassic Park: Trespasser Recompiled"
            VALUE "ProductVersion", JPT_VERSION_STRING
            VALUE "Comments", "https://github.com/saulob/jurassic-park-trespasser-recomp"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
